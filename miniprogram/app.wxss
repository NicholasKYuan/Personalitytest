/* ============================================================
   星鉴人格 · 全局样式（v2.0 暖光星语）
   基调：暖米白底 + 深墨文字 + 纯白悬浮卡片
   品牌主渐变：珊瑚红 #F2545B → 紫罗兰 #8B5CF6
   ============================================================ */

page {
  /* ---- 品牌主色 ---- */
  --brand-coral: #F2545B;
  --brand-coral-deep: #E03E52;
  --brand-violet: #8B5CF6;
  --brand-gradient: linear-gradient(135deg, #F2545B 0%, #8B5CF6 100%);
  /* 承载白色文字的品牌渐变（起点加深至 #D13841，白字对比度 4.8:1 过 AA） */
  --btn-gradient: linear-gradient(135deg, #D13841 0%, #8B5CF6 100%);

  /* ---- 彩虹辅助色（四体系主题色，仅用于图表/装饰/大字，勿用于小字） ---- */
  --rainbow-red: #F2545B;
  --rainbow-orange: #F59E0B;
  --rainbow-green: #34C77B;
  --rainbow-blue: #3B9ED8;
  --rainbow-violet: #8B5CF6;
  --rainbow-purple: #C65CF0;

  /* ---- 徽章专用深色文字（在 10% 浅色底上对比度 ≥ 4.5:1） ---- */
  --badge-text-red: #C03A42;     /* 4.76:1 on red tint */
  --badge-text-violet: #6D3FD4;  /* 5.61:1 on violet tint */
  --badge-text-blue: #186FA6;    /* 4.91:1 on blue tint */
  --badge-text-green: #177E4A;   /* 4.70:1 on green tint */

  /* ---- 背景 ---- */
  --bg-page: #FAF7F2;
  --bg-glow-top: #FFF3E8;
  --bg-glow-violet: #F3EFFF;
  --bg-card: #FFFFFF;
  --bg-card-soft: #FFF9F4;

  /* ---- 文字 ---- */
  --text-main: #2B2622;
  --text-sub: #6E665E;
  --text-muted: #756A60;       /* 修复：原 #A89F95 仅 2.44:1 → 现 4.93:1 过 AA */
  --text-onbrand: #FFFFFF;

  /* ---- 品牌色作为小字文字色（对比度 ≥ 4.5:1） ---- */
  --text-coral: #CD3540;       /* 4.70:1 on bg-page，用于 btn-text/链接/强调文字 */
  --text-violet: #6D3FD4;      /* 5.93:1 on bg-page */
  --text-warning: #8F5A00;     /* 5.41:1 on bg-page，替代 #F59E0B 直接作文字色 */
  --text-warning-deep: #92400E; /* 警示横幅正文 */

  /* ---- 线条与分割 ---- */
  --border-light: #F0EAE2;
  --border-card: #F3EEE7;
  --border-focus: #F2545B;

  /* ---- 功能色 ---- */
  --color-success: #34C77B;
  --color-warning: #F59E0B;
  --color-error: #F2545B;
  --color-info: #3B9ED8;
  --bg-warning-soft: #FEF3C7;  /* 警示横幅/标签浅底 */

  /* ---- 星光点缀 ---- */
  --star-gold: rgba(245, 158, 11, 0.55);
  --star-violet: rgba(139, 92, 246, 0.45);
  --star-coral: rgba(242, 84, 91, 0.45);

  /* ---- 阴影 ---- */
  --shadow-card: 0 4rpx 24rpx rgba(43, 38, 34, 0.06);
  --shadow-card-lg: 0 12rpx 40rpx rgba(43, 38, 34, 0.10);
  --shadow-brand: 0 10rpx 32rpx rgba(242, 84, 91, 0.28);
  --shadow-logo: 0 8rpx 28rpx rgba(43, 38, 34, 0.10);

  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-glow-top) 0%, var(--bg-page) 28%, var(--bg-page) 100%);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ---------- 页面通用容器 ---------- */
.page {
  padding: 32rpx 32rpx 80rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* ---------- 卡片（原 glass-card，重定义为白卡，类名保留） ---------- */
.glass-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border-card);
  border-radius: 32rpx;
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.card {
  background: var(--bg-card);
  border-radius: 32rpx;
  border: 1rpx solid var(--border-card);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

/* 品牌强调卡片（付费转化等） */
.card--brand {
  background: linear-gradient(160deg, #FFF1F0 0%, #F5F0FF 100%);
  border: 1rpx solid rgba(242, 84, 91, 0.18);
}

/* ---------- 标题 ---------- */
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  margin: 48rpx 0 24rpx;
  padding-left: 20rpx;
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: var(--brand-gradient);
}

.section-title-sm {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

/* ---------- 按钮 ---------- */
.btn-block {
  width: 100%;
  box-sizing: border-box;
}

.btn-primary {
  background: var(--btn-gradient);
  color: var(--text-onbrand);
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 26rpx 0;
  line-height: 1.4;
  border: none;
  box-shadow: var(--shadow-brand);
  /* 防止长文案在系统字体放大/窄屏下换行（如"元"字单独掉行） */
  white-space: nowrap;
  overflow: hidden;
}

.btn-primary:active {
  opacity: 0.88;
  transform: scale(0.98);
}

.btn-ghost {
  background: var(--bg-card);
  color: var(--text-main);
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 999rpx;
  padding: 22rpx 0;
  line-height: 1.4;
  border: 2rpx solid var(--border-light);
  box-shadow: var(--shadow-card);
  white-space: nowrap;
  overflow: hidden;
}

.btn-text {
  color: var(--text-coral);
  font-size: 28rpx;
  font-weight: 500;
  background: transparent;
}

/* ---------- 可点击 view 的触感反馈（配合 hover-class="hover-press"） ---------- */
.hover-press {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ---------- 底部固定操作栏（pay/result-full 共用） ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid var(--border-light);
  box-shadow: 0 -4rpx 24rpx rgba(43, 38, 34, 0.06);
  z-index: 100;
  box-sizing: border-box;
}

/* 微信 button 默认样式清除 */
button::after {
  border: none;
}

button[disabled] {
  background: #EFEAE3 !important;
  color: var(--text-muted) !important;
  box-shadow: none;
  opacity: 1;
}

/* ---------- 星光装饰（浅色系微光） ---------- */
.bg-stars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 900rpx;
  pointer-events: none;
  overflow: hidden;
}

.star {
  position: absolute;
  border-radius: 50%;
  background: var(--star-gold);
  animation: twinkle 3s ease-in-out infinite;
}

.star:nth-child(3n + 1) {
  background: var(--star-violet);
}

.star:nth-child(3n + 2) {
  background: var(--star-coral);
}

@keyframes twinkle {
  0%, 100% { opacity: 0.25; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.25); }
}

/* ---------- Logo 容器（白底圆角矩形，logo 与容器融为一体） ---------- */
.logo-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: var(--shadow-logo);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-wrap image {
  width: 88%;
  height: 88%;
}

.logo-wrap--hero {
  width: 160rpx;
  height: 160rpx;
  border-radius: 36rpx;
}

.logo-wrap--md {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
}

.logo-wrap--sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
}

.logo-wrap--xs {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
}

/* ---------- 入场动画 ---------- */
.fade-in {
  animation: fadeSlideIn 0.5s ease both;
  opacity: 1; /* 兜底：动画未触发也保证可见 */
}

@keyframes fadeSlideIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---------- 通用文本 ---------- */
.text-muted {
  color: var(--text-muted);
}

.text-sub {
  color: var(--text-sub);
}
