.index-page {
  position: relative;
  overflow: hidden;
}

/* ---------- 品牌头部 ---------- */
.hero {
  text-align: center;
  padding: 60rpx 0 20rpx;
}

.hero-logo {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  /* 品牌渐变字标：background-clip 不支持时兜底为深珊瑚纯色 */
  background: var(--brand-gradient);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: #D13841;
}

.hero-slogan {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-coral);
  letter-spacing: 4rpx;
}

.hero-desc {
  margin-top: 28rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-sub);
  padding: 0 24rpx;
}

/* ---------- 体系标签（彩虹四色徽章） ---------- */
.system-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.system-tag {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* 九型人格 → 珊瑚红 */
.system-tag--0 {
  color: var(--badge-text-red);
  background: rgba(242, 84, 91, 0.10);
  border: 1rpx solid rgba(242, 84, 91, 0.30);
}

/* MBTI → 紫罗兰 */
.system-tag--1 {
  color: var(--badge-text-violet);
  background: rgba(139, 92, 246, 0.10);
  border: 1rpx solid rgba(139, 92, 246, 0.30);
}

/* 霍兰德 → 蓝 */
.system-tag--2 {
  color: var(--badge-text-blue);
  background: rgba(59, 158, 216, 0.10);
  border: 1rpx solid rgba(59, 158, 216, 0.30);
}

/* 盖洛普 → 绿 */
.system-tag--3 {
  color: var(--badge-text-green);
  background: rgba(52, 199, 123, 0.10);
  border: 1rpx solid rgba(52, 199, 123, 0.30);
}

/* ---------- 卖点 ---------- */
.feature-list {
  padding: 16rpx 28rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.feature-item + .feature-item {
  border-top: 1rpx solid var(--border-light);
}

.feature-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: var(--brand-gradient);
  flex-shrink: 0;
}

.feature-title {
  font-size: 28rpx;
  color: var(--text-sub);
}

/* ---------- 用户评价 ---------- */
.review-card {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.review-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-sub);
}

.review-author {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ---------- 数据统计 ---------- */
.stats-section {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0;
  margin-top: 8rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--brand-coral);
  font-variant-numeric: tabular-nums;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.stat-divider {
  width: 1rpx;
  height: 72rpx;
  background: var(--border-light);
}

/* ---------- 底部 ---------- */
.footer {
  margin-top: 48rpx;
  text-align: center;
}

.footer-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.footer-history {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-coral);
}

.footer-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.footer-links .footer-history {
  margin-top: 0;
}

.footer-divider {
  color: var(--text-muted);
  font-size: 24rpx;
}

.footer-records {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-violet);
}

/* ---------- 阶梯入场 ---------- */
.index-page .section:nth-of-type(3) {
  animation-delay: 0.1s;
}

.index-page .section:nth-of-type(4) {
  animation-delay: 0.2s;
}

.stats-section.fade-in {
  animation-delay: 0.3s;
}

.index-page .footer.fade-in {
  animation-delay: 0.4s;
}
