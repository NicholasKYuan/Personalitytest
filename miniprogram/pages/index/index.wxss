.index-page {
  position: relative;
  overflow: hidden;
}

/* ---------- 品牌头部 ---------- */
.hero {
  text-align: center;
  padding: 60rpx 0 20rpx;
}

.hero-logo {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.logo-circle {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E94560, #7C3AED);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 800;
  color: #fff;
  box-shadow: 0 16rpx 56rpx rgba(233, 69, 96, 0.45), inset 0 0 24rpx rgba(255, 255, 255, 0.18);
}

.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  color: #fff;
  text-shadow: 0 4rpx 30rpx rgba(124, 58, 237, 0.6);
}

.hero-slogan {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 4rpx;
  background: linear-gradient(90deg, #F59E0B, #E94560);
  -webkit-background-clip: text;
  color: transparent;
}

.hero-desc {
  margin-top: 28rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-sub);
  padding: 0 24rpx;
}

/* ---------- 体系标签 ---------- */
.system-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.system-tag {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(233, 69, 96, 0.16);
  border: 1rpx solid rgba(233, 69, 96, 0.4);
  color: #F8A5B5;
  font-size: 26rpx;
  font-weight: 500;
}

/* ---------- 卖点 ---------- */
.feature-list {
  padding: 16rpx 28rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.feature-item + .feature-item {
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.feature-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #E94560, #7C3AED);
  flex-shrink: 0;
}

.feature-title {
  font-size: 28rpx;
  color: var(--text-sub);
}

/* ---------- 用户评价 ---------- */
.review-card {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.review-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.88);
}

.review-author {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ---------- 数据统计 ---------- */
.stats-section {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0;
  margin-top: 8rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.stat-divider {
  width: 1rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.15);
}

/* ---------- 底部 ---------- */
.footer {
  margin-top: 48rpx;
  text-align: center;
}

.footer-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.footer-history {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.55);
  text-decoration: underline;
}
