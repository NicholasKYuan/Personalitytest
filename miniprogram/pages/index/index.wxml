<view class="page index-page">
  <!-- 星空背景 -->
  <view class="bg-stars">
    <view class="star" style="left:8%;top:12%;width:8rpx;height:8rpx;animation-delay:0s;"></view>
    <view class="star" style="left:20%;top:28%;width:6rpx;height:6rpx;animation-delay:0.6s;"></view>
    <view class="star" style="left:32%;top:8%;width:10rpx;height:10rpx;animation-delay:1.2s;"></view>
    <view class="star" style="left:48%;top:20%;width:6rpx;height:6rpx;animation-delay:0.3s;"></view>
    <view class="star" style="left:62%;top:10%;width:8rpx;height:8rpx;animation-delay:1.6s;"></view>
    <view class="star" style="left:78%;top:24%;width:6rpx;height:6rpx;animation-delay:0.9s;"></view>
    <view class="star" style="left:88%;top:12%;width:10rpx;height:10rpx;animation-delay:2s;"></view>
    <view class="star" style="left:94%;top:32%;width:6rpx;height:6rpx;animation-delay:0.4s;"></view>
  </view>

  <!-- 品牌头部 -->
  <view class="hero fade-in">
    <view class="hero-logo">
      <view class="logo-wrap logo-wrap--hero">
        <image src="/assets/logo.jpg" mode="aspectFit" />
      </view>
    </view>
    <view class="hero-title">星耀启程</view>
    <view class="hero-slogan">发现你的独特光芒</view>
    <view class="hero-desc">融合九型人格、MBTI、霍兰德职业兴趣、盖洛普优势识别四大权威体系，通过 120 道精心设计的场景题，全方位解码你的人格密码。</view>
  </view>

  <!-- 测试说明 -->
  <view class="section fade-in">
    <view class="section-title">四体系融合人格测评</view>
    <view class="system-tags">
      <view class="system-tag system-tag--{{index}}" wx:for="{{systems}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="feature-list glass-card">
      <view class="feature-item" wx:for="{{features}}" wx:key="title">
        <view class="feature-dot"></view>
        <view class="feature-title">{{item.title}}</view>
      </view>
    </view>
  </view>

  <!-- 用户评价 -->
  <view class="section fade-in">
    <view class="section-title">用户评价</view>
    <view class="review-card glass-card" wx:for="{{reviews}}" wx:key="text">
      <view class="review-text">{{item.text}}</view>
      <view class="review-author">-- {{item.author}}</view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-section glass-card fade-in">
    <view class="stat-item">
      <view class="stat-num">{{completedCount}}</view>
      <view class="stat-label">人已完成测评</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">4.8 / 5.0</view>
      <view class="stat-label">平均评分</view>
    </view>
  </view>

  <!-- 底部行动 -->
  <view class="footer fade-in">
    <button class="btn-primary btn-block" bindtap="onStart">开始免费测评</button>
    <view class="footer-tip">答题免费，详细报告可选择性解锁</view>
    <view class="footer-history" bindtap="onStart">开始我的探索</view>
  </view>
</view>
