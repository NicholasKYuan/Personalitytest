.report-page {
  padding-bottom: 220rpx;
}

/* ---------- 加载态 ---------- */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0 120rpx;
}

.loading-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 8rpx solid #EFE9E0;
  border-top-color: #F2545B;
  animation: spin 1s linear infinite;
  margin-bottom: 48rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.loading-sub {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 24rpx;
}

.loading-tip {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ---------- 报告头 ---------- */
.report-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.rh-logo {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.logo-wrap--sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
}

.rh-greet {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

.rh-badges {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.rh-badge {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--brand-coral);
  background: rgba(242, 84, 91, 0.10);
  border: 1rpx solid rgba(242, 84, 91, 0.30);
}

.rh-meta {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ---------- 章节卡片 ---------- */
.section-card {
  padding: 32rpx;
  margin-bottom: 28rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.sec-index {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #F2545B, #8B5CF6);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.sec-title {
  position: relative;
  padding-left: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.sec-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: var(--brand-gradient);
}

.sec-body {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text-sub);
}

/* ---------- 结尾 ---------- */
.report-end {
  text-align: center;
  padding: 20rpx 40rpx 40rpx;
}

.end-logo {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.logo-wrap--xs {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
}

.end-line {
  width: 80rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, #F2545B, #8B5CF6);
  margin: 0 auto 20rpx;
}

.end-brand {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 12rpx;
}

.end-text {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.7;
}

/* ---------- 海报画布 ---------- */
.poster-canvas {
  z-index: -1;
  pointer-events: none;
}

/* ---------- 底部操作栏 ---------- */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid var(--border-light);
  box-shadow: 0 -4rpx 24rpx rgba(43, 38, 34, 0.06);
}

.ab-btn {
  flex: 1;
  background: linear-gradient(135deg, #F2545B 0%, #8B5CF6 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 22rpx 0;
  line-height: 1.4;
  border: none;
  margin: 0;
}

.ab-btn--ghost {
  background: var(--bg-card);
  border: 2rpx solid var(--border-light);
  color: var(--text-main);
  box-shadow: none;
}

button::after {
  border: none;
}
