.report-page {
  padding-bottom: 220rpx;
}

/* ---------- 加载态 ---------- */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0 120rpx;
}

.loading-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 255, 255, 0.12);
  border-top-color: #E94560;
  animation: spin 1s linear infinite;
  margin-bottom: 48rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
}

.loading-sub {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 24rpx;
}

.loading-tip {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ---------- 报告头 ---------- */
.report-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.rh-greet {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 4rpx 30rpx rgba(124, 58, 237, 0.5);
  margin-bottom: 20rpx;
}

.rh-badges {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.rh-badge {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #F8A5B5;
  background: rgba(233, 69, 96, 0.14);
  border: 1rpx solid rgba(233, 69, 96, 0.35);
}

.rh-meta {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ---------- 章节卡片 ---------- */
.section-card {
  padding: 32rpx;
  margin-bottom: 28rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.sec-index {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #E94560, #7C3AED);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.sec-body {
  font-size: 28rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.85);
}

/* ---------- 结尾 ---------- */
.report-end {
  text-align: center;
  padding: 20rpx 40rpx 40rpx;
}

.end-line {
  width: 80rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, #E94560, #7C3AED);
  margin: 0 auto 20rpx;
}

.end-text {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.7;
}

/* ---------- 海报画布 ---------- */
.poster-canvas {
  z-index: -1;
  pointer-events: none;
}

/* ---------- 底部操作栏 ---------- */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(26, 26, 46, 0.96);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.ab-btn {
  flex: 1;
  background: linear-gradient(135deg, #E94560 0%, #7C3AED 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 22rpx 0;
  line-height: 1.4;
  border: none;
  margin: 0;
}

.ab-btn--ghost {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid var(--card-border);
  color: var(--text-main);
}

button::after {
  border: none;
}
