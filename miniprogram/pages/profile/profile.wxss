.profile-header {
  margin-bottom: 32rpx;
}

.ph-head-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.ph-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
}

.ph-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-sub);
}

/* ---------- 表单卡片 ---------- */
.form-card {
  padding: 8rpx 32rpx;
  margin-bottom: 40rpx;
}

.form-row {
  padding: 26rpx 0;
}

.form-row + .form-row {
  border-top: 1rpx solid var(--border-light);
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.form-required {
  color: var(--brand-coral);
  font-weight: 700;
}

.form-optional {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-muted);
  margin-left: 8rpx;
}

.form-input {
  height: 84rpx;
  background: #FBF8F4;
  border: 2rpx solid var(--border-light);
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--text-main);
  box-sizing: border-box;
}

/* 聚焦态：品牌色描边 + 白底（由 JS focusField 切换） */
.form-input--focus {
  border-color: var(--brand-coral);
  background: #FFFFFF;
}

.ph {
  color: var(--text-muted);
}

.form-picker {
  height: 84rpx;
  background: #FBF8F4;
  border: 2rpx solid var(--border-light);
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--text-main);
  line-height: 84rpx;
  box-sizing: border-box;
}

.form-picker--placeholder {
  color: var(--text-muted);
}

.form-error {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-error);
}

.form-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--brand-coral);
  font-weight: 500;
}

/* ---------- 底部 ---------- */
.profile-footer {
  text-align: center;
}

.privacy-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}
