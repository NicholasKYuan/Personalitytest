.profile-header {
  margin-bottom: 32rpx;
}

.ph-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 12rpx;
}

.ph-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-sub);
}

/* ---------- 表单卡片 ---------- */
.form-card {
  padding: 8rpx 32rpx;
  margin-bottom: 40rpx;
}

.form-row {
  padding: 26rpx 0;
}

.form-row + .form-row {
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 14rpx;
}

.form-required {
  color: #E94560;
  font-weight: 700;
}

.form-optional {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-muted);
  margin-left: 8rpx;
}

.form-input {
  height: 84rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #fff;
  box-sizing: border-box;
}

.ph {
  color: rgba(255, 255, 255, 0.35);
}

.form-picker {
  height: 84rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #fff;
  line-height: 84rpx;
}

.form-picker--placeholder {
  color: rgba(255, 255, 255, 0.35);
}

.form-error {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #F25C7A;
}

/* ---------- 底部 ---------- */
.profile-footer {
  text-align: center;
}

.privacy-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}
