.pay-page {
  padding-bottom: 220rpx;
}

/* ---------- 顶部 logo ---------- */
.pay-logo {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.logo-wrap--md {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
}

.pay-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 28rpx;
}

/* ---------- 顶部价格卡 ---------- */
.price-card {
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  text-align: center;
  background: linear-gradient(160deg, #FFF1F0 0%, #F5F0FF 100%);
  border: 1rpx solid rgba(242, 84, 91, 0.18);
  position: relative;
}

.pc-badge {
  display: inline-block;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--color-warning);
  background: rgba(245, 158, 11, 0.12);
  border: 1rpx solid rgba(245, 158, 11, 0.35);
  margin-bottom: 20rpx;
}

.pc-price-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.pc-price {
  display: flex;
  align-items: baseline;
}

.pc-currency {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brand-coral);
}

.pc-amount {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--brand-coral);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.pc-original {
  font-size: 28rpx;
  color: var(--text-muted);
  text-decoration: line-through;
}

.pc-subtitle {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* ---------- 兑换密钥 ---------- */
.redeem-card {
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 32rpx;
}

.rd-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.rd-input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.rd-input {
  flex: 1;
  height: 80rpx;
  background: #FBF8F4;
  border: 2rpx solid var(--border-light);
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-main);
  letter-spacing: 2rpx;
  box-sizing: border-box;
}

.rd-placeholder {
  color: var(--text-muted);
  letter-spacing: 0;
}

.rd-btn {
  flex-shrink: 0;
  background: var(--color-purple, #8B5CF6);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 0 36rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: none;
  margin: 0;
}

.rd-btn[disabled] {
  background: #EFEAE3 !important;
  color: var(--text-muted) !important;
}

.rd-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ---------- 章节价值清单 ---------- */
.chapter-card {
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
}

.ch-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.ch-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-main);
}

.ch-words {
  font-size: 22rpx;
  color: var(--brand-coral);
  background: rgba(242, 84, 91, 0.10);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.ch-preview {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(43, 38, 34, 0.4);
}

.ch-preview.blurred {
  filter: blur(4px);
  -webkit-filter: blur(4px);
  user-select: none;
}

/* ---------- 权益说明 ---------- */
.benefit-card {
  padding: 28rpx;
  margin-bottom: 32rpx;
}

.bn-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.bn-item:last-child {
  margin-bottom: 0;
}

.bn-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  margin-top: 6rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.bn-text {
  font-size: 26rpx;
  color: var(--text-main);
}

/* ---------- 底部固定支付栏 ---------- */
.pay-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid var(--border-light);
  box-shadow: 0 -4rpx 24rpx rgba(43, 38, 34, 0.06);
}

.pb-info {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-shrink: 0;
}

.pb-total {
  display: flex;
  align-items: baseline;
}

.pb-currency {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-coral);
}

.pb-amount {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--brand-coral);
  font-variant-numeric: tabular-nums;
}

.pb-original {
  font-size: 24rpx;
  color: var(--text-muted);
  text-decoration: line-through;
}

.pb-btn {
  flex: 1;
  background: linear-gradient(135deg, #F2545B 0%, #8B5CF6 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 24rpx 0;
  line-height: 1.4;
  border: none;
  box-shadow: 0 10rpx 32rpx rgba(242, 84, 91, 0.28);
  margin: 0;
}

.pb-btn[disabled] {
  background: #EFEAE3 !important;
  color: var(--text-muted) !important;
  box-shadow: none;
  opacity: 1;
}

.trust-line {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ---------- AI 生成进度遮罩 ---------- */
.gen-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.gen-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 56rpx 48rpx 48rpx;
  width: 600rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.gen-icon {
  margin-bottom: 32rpx;
}

.gen-spinner {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto;
  border: 6rpx solid #f0f0f0;
  border-top-color: #8B5CF6;
  border-radius: 50%;
  animation: gen-spin 1s linear infinite;
}

@keyframes gen-spin {
  to { transform: rotate(360deg); }
}

.gen-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.gen-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 40rpx;
}

.gen-progress-wrap {
  width: 100%;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.gen-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #F2545B, #8B5CF6);
  border-radius: 999rpx;
  transition: width 0.5s ease;
}

.gen-progress-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand-coral);
  margin-bottom: 24rpx;
}

.gen-time {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.gen-tip {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.5;
}
