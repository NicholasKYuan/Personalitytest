.records-page {
  padding-top: 60rpx;
}

.records-header {
  margin-bottom: 40rpx;
}

.records-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.records-subtitle {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 加载/空状态 */
.loading-state {
  padding: 120rpx 0;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

.empty-state {
  padding: 80rpx 48rpx;
  text-align: center;
  margin-top: 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 48rpx;
}

/* 记录列表 */
.records-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.record-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.record-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.record-left {
  flex: 1;
  min-width: 0;
}

.record-date {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.record-preview {
  font-size: 28rpx;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.record-badge {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.record-badge--paid {
  background: rgba(52, 199, 123, 0.1);
  color: var(--badge-text-green);
}

.record-badge--unpaid {
  background: rgba(245, 158, 11, 0.1);
  color: var(--text-warning);
}

.record-arrow {
  font-size: 40rpx;
  color: var(--text-muted);
  line-height: 1;
}

/* 底部提示 */
.records-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 48rpx;
}
