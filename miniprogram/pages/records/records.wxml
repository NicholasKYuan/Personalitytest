<view class="page records-page">
  <view class="records-header fade-in">
    <view class="records-title">我的测评记录</view>
    <view class="records-subtitle">未付费记录保留 7 天，已付费保留 30 天</view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state glass-card fade-in" wx:if="{{!loading && records.length === 0}}">
    <view class="empty-icon">📋</view>
    <view class="empty-title">暂无测评记录</view>
    <view class="empty-desc">完成一次测评后，记录会显示在这里</view>
    <button class="btn-primary btn-block" bindtap="onGoHome">开始免费测评</button>
  </view>

  <!-- 记录列表 -->
  <view class="records-list" wx:if="{{!loading && records.length > 0}}">
    <view class="record-card glass-card fade-in" wx:for="{{records}}" wx:key="session_id"
          data-id="{{item.session_id}}" data-paid="{{item.paid}}" bindtap="onRecordTap">
      <view class="record-left">
        <view class="record-date">{{item.dateText}}</view>
        <view class="record-preview">{{item.preview || '测评已完成'}}</view>
      </view>
      <view class="record-right">
        <view class="record-badge record-badge--paid" wx:if="{{item.paid}}">已解锁</view>
        <view class="record-badge record-badge--unpaid" wx:else>待解锁</view>
        <view class="record-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="records-tip fade-in" wx:if="{{!loading && records.length > 0}}">
    点击记录可查看报告或继续解锁
  </view>
</view>
