.result-free-page {
  padding-bottom: 100rpx;
}

/* ---------- 头部 ---------- */
.rf-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.rf-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 4rpx 30rpx rgba(124, 58, 237, 0.5);
}

.rf-subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  letter-spacing: 2rpx;
}

/* ---------- 雷达图 ---------- */
.radar-card {
  padding: 28rpx 24rpx 20rpx;
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.radar-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
  width: 100%;
}

.radar-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.2s ease;
}

.radar-tab--active {
  color: #fff;
  background: rgba(233, 69, 96, 0.2);
  border-color: rgba(233, 69, 96, 0.55);
  font-weight: 600;
}

/* ---------- 四体系卡片 ---------- */
.cards-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  margin-bottom: 28rpx;
}

.result-card {
  width: calc(50% - 11rpx);
  box-sizing: border-box;
  padding: 30rpx 26rpx;
  text-align: center;
}

.rc-title {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 14rpx;
}

.rc-type {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.rc-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-sub);
  min-height: 76rpx;
}

.rc-cta {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #F8A5B5;
  text-decoration: underline;
}

/* ---------- 免费简述 ---------- */
.free-summary {
  padding: 32rpx;
  margin-bottom: 28rpx;
}

.fs-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}

.fs-text {
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--text-sub);
}

/* ---------- 模糊预览 ---------- */
.paid-preview {
  padding: 32rpx;
  margin-bottom: 28rpx;
}

.pp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pp-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.pp-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #F8A5B5;
  background: rgba(233, 69, 96, 0.16);
  border: 1rpx solid rgba(233, 69, 96, 0.4);
}

.pp-item {
  margin-bottom: 20rpx;
}

.pp-item:last-child {
  margin-bottom: 0;
}

.pp-item-title {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 8rpx;
}

.pp-item-text.blurred {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.35);
  filter: blur(5px);
  -webkit-filter: blur(5px);
  user-select: none;
}

/* ---------- 付费转化 ---------- */
.cta-card {
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  border-color: rgba(233, 69, 96, 0.35);
  background: linear-gradient(160deg, rgba(233, 69, 96, 0.12), rgba(124, 58, 237, 0.12));
}

.cta-quote {
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--text-sub);
  margin-bottom: 24rpx;
}

.cta-value {
  margin-bottom: 32rpx;
}

.cv-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.cv-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E94560, #7C3AED);
  margin-top: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.cv-text {
  font-size: 27rpx;
  color: rgba(255, 255, 255, 0.88);
}

.cta-trust {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ---------- 分享 ---------- */
.share-btn {
  width: 100%;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding: 22rpx 0;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  color: var(--text-sub);
  font-size: 28rpx;
}
