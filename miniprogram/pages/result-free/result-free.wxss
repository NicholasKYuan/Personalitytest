.result-free-page {
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* ---------- 头部 ---------- */
.rf-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.rf-logo {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.rf-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-main);
}

.rf-subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
}

/* ---------- 雷达图 ---------- */
.radar-card {
  padding: 28rpx 24rpx 20rpx;
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.radar-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
  width: 100%;
}

.radar-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  background: var(--bg-card);
  border: 1rpx solid var(--border-light);
  transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
}

.radar-tab--active {
  color: var(--text-coral);
  background: rgba(242, 84, 91, 0.08);
  border-color: rgba(242, 84, 91, 0.45);
  font-weight: 600;
}

/* ---------- 四体系卡片 ---------- */
.cards-grid {
  display: flex;
  flex-wrap: wrap;
  /* 不用 gap：calc(50%) + gap 恰好凑满 100%，亚像素进位会导致换行 */
  justify-content: space-between;
  margin-bottom: 6rpx; /* 卡片自带下间距 22rpx，合计 28rpx */
}

.result-card {
  width: 48.5%;
  margin-bottom: 22rpx;
  box-sizing: border-box;
  padding: 30rpx 26rpx;
  text-align: center;
}

.rc-title {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 14rpx;
}

.rc-type {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
  /* 九型最长"4号·个人主义者"约 9 字，34rpx 在 48.5% 卡宽内单行放下 */
  white-space: nowrap;
}

.rc-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-sub);
  min-height: 76rpx;
}

.rc-cta {
  margin-top: 18rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-coral);
}

/* ---------- 免费简述 ---------- */
.free-summary {
  padding: 32rpx;
  margin-bottom: 28rpx;
}

.fs-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.fs-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text-sub);
}

/* ---------- 模糊预览 ---------- */
.paid-preview {
  padding: 32rpx;
  margin-bottom: 28rpx;
  background: linear-gradient(160deg, #FFF1F0 0%, #F5F0FF 100%);
  border: 1rpx solid rgba(242, 84, 91, 0.18);
}

.pp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pp-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.pp-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--badge-text-red);
  background: rgba(242, 84, 91, 0.10);
  border: 1rpx solid rgba(242, 84, 91, 0.30);
}

.pp-item {
  margin-bottom: 20rpx;
}

.pp-item:last-child {
  margin-bottom: 0;
}

.pp-item-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.pp-item-text.blurred {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(43, 38, 34, 0.4);
  filter: blur(5px);
  -webkit-filter: blur(5px);
  user-select: none;
}

/* ---------- 付费转化 ---------- */
.cta-card {
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(242, 84, 91, 0.18);
  background: linear-gradient(160deg, #FFF1F0 0%, #F5F0FF 100%);
}

.cta-quote {
  font-size: 28rpx;
  line-height: 1.8;
  font-style: italic;
  color: var(--text-sub);
  margin-bottom: 24rpx;
}

.cta-value {
  margin-bottom: 32rpx;
}

.cv-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.cv-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F2545B, #8B5CF6);
  margin-top: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.cv-text {
  font-size: 28rpx;
  color: var(--text-main);
}

.cta-trust {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* CTA 按钮字号略降，保证"解锁完整报告 ¥29.9"在大字体模式下单行放下 */
.cta-card .btn-primary {
  font-size: 30rpx;
}

/* ---------- 分享 ---------- */
.share-btn {
  width: 100%;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding: 22rpx 0;
  border-radius: 999rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border-light);
  box-shadow: 0 4rpx 24rpx rgba(43, 38, 34, 0.06);
  color: var(--text-main);
  font-size: 28rpx;
  /* 防止"评"字单独掉行 */
  white-space: nowrap;
  overflow: hidden;
}
