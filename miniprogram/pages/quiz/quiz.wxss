.quiz-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---------- 进度条 ---------- */
.progress-section {
  margin-bottom: 32rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-label {
  position: relative;
  padding-left: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* 进度数字左侧小星光点 */
.progress-label::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
}

.progress-percent {
  font-size: 26rpx;
  color: var(--text-sub);
  font-variant-numeric: tabular-nums;
}

.progress-track {
  width: 100%;
  height: 12rpx;
  background: #EFE9E0;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--brand-gradient);
  border-radius: 999rpx;
  transition: width 0.4s ease;
}

/* ---------- 题目卡片 ---------- */
.question-card {
  padding: 40rpx 32rpx;
  flex: 1;
}

.question-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.badge-category {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--badge-text-red);
  background: rgba(242, 84, 91, 0.10);
  border: 1rpx solid rgba(242, 84, 91, 0.30);
}

/* 九型 → 红 */
.badge--enneagram {
  color: var(--badge-text-red);
  background: rgba(242, 84, 91, 0.10);
  border-color: rgba(242, 84, 91, 0.30);
}

/* MBTI → 紫 */
.badge--mbti {
  color: var(--badge-text-violet);
  background: rgba(139, 92, 246, 0.10);
  border-color: rgba(139, 92, 246, 0.30);
}

/* 霍兰德 → 蓝 */
.badge--holland {
  color: var(--badge-text-blue);
  background: rgba(59, 158, 216, 0.10);
  border-color: rgba(59, 158, 216, 0.30);
}

/* 盖洛普 → 绿 */
.badge--gallup {
  color: var(--badge-text-green);
  background: rgba(52, 199, 123, 0.10);
  border-color: rgba(52, 199, 123, 0.30);
}

.badge-scale {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--badge-text-violet);
  background: rgba(139, 92, 246, 0.10);
  border: 1rpx solid rgba(139, 92, 246, 0.30);
}

.question-stem {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.65;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.question-hint {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 36rpx;
  letter-spacing: 2rpx;
}

/* ---------- 选项 ---------- */
.options {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border-light);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
}

.option-item--selected {
  border-color: var(--brand-coral);
  background: #FFF5F4;
  box-shadow: 0 6rpx 20rpx rgba(242, 84, 91, 0.14);
}

.option-mark {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  border: 2rpx solid #E3DCD2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

.option-item--selected .option-mark {
  background: var(--brand-coral);
  border-color: var(--brand-coral);
  color: #fff;
}

.option-text {
  font-size: 30rpx;
  line-height: 1.55;
  color: var(--text-main);
}

/* ---------- 底部导航 ---------- */
.bottom-nav {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 36rpx;
}

.btn-prev {
  padding: 22rpx 44rpx;
  border-radius: 999rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border-light);
  box-shadow: var(--shadow-card);
  color: var(--text-main);
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  flex-shrink: 0;
}

.btn-prev--disabled {
  color: var(--text-muted);
  box-shadow: none;
}

.btn-submit {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 999rpx;
  background: var(--btn-gradient);
  color: var(--text-onbrand);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: var(--shadow-brand);
  white-space: nowrap;
  overflow: hidden;
}

.swipe-hint {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 滑动引导微动画（仅 transform/opacity，GPU 加速） */
.swipe-hint::before {
  content: '‹ ›';
  display: inline-block;
  margin-right: 10rpx;
  letter-spacing: 6rpx;
  animation: swipeNudge 1.8s ease-in-out infinite;
}

@keyframes swipeNudge {
  0%, 100% { transform: translateX(0); opacity: 0.5; }
  50% { transform: translateX(-6rpx); opacity: 1; }
}
